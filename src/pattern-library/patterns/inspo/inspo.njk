<div class="inspo {{ data.styles }}"{% if data.variant %} {{ data.variant }}{% endif %}>
  <div class="wrapper">
    {% set heading = data.heading | default({}, true) %}
    {% set headingLevel = heading.level | default(2, true) %}
    <h{{ headingLevel }} class="visually-hidden">{{ data.heading }}</h{{ headingLevel }}>
    <div class="inspo__grid">
      {% for line in data.displayHeading %}
        <p class="inspo__heading mt-zero" aria-hidden="true">{{ line }}</p>
      {% endfor %}
      {% if data.img %}
      <div class="inspo__img">
        <img src="{{ data.img.src }}" alt="{{ data.img.alt }}" loading="lazy"/>
      </div>
      {% endif %}
    </div>
  </div>
</div>